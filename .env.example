# API Key lấy từ data.go.kr (đăng ký cho dịch vụ 대학알리미)
# Thử dùng bản Decoding Service Key trước, nếu lỗi kết nối/xác thực thì thử bản Encoding Service Key
ACADEMYINFO_API_KEY=your_open_api_key_from_data_go_kr

# Chuỗi kết nối PostgreSQL (ví dụ lấy từ Neon.tech, Supabase, hay Render)
DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require
